rules_version = '2';

// Sri Krishna Condiments — Firestore Security Rules
//
// ⚠️  ARCHITECTURE NOTE: This app uses PIN-based admin auth (not Firebase Auth).
// The Firebase API key IS intentionally public — it only identifies the project,
// it does not grant access by itself. Security comes from these rules.
//
// What these rules protect:
//   ✅ adminUsers (contains admin PINs) — closed to all clients
//   ✅ settings/admin (legacy admin PIN) — closed to all clients
//   ✅ authThrottle (failed-login counters) — closed to all clients
//   ✅ Creates on orders/customers/subscriptions/feedback are shape-validated
//
// ⚠️  WHAT IS STILL OPEN — do not read the list above as more than it says.
//   ⚠️  agents/{id} contains agent PINs and commission data, and is still
//       world readable and writable. The admin Agents page and the agent
//       console both talk to it directly from the browser, so closing it
//       needs those flows moved server-side first.
//   ⚠️  customers and orders are world readable (names, WhatsApp numbers,
//       order history) and world writable, including delete.
//   ⚠️  products, stock, expenses, batches, recipes and raw-material costs
//       are world writable — anyone can change a selling price.
//
//   None of this can be fixed by rules alone: the admin panel talks to
//   Firestore directly from the browser, and without Firebase Auth a rule
//   cannot tell an admin's browser from a stranger's. Closing these requires
//   the Firebase Auth migration, tracked as the next step.

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════
    // PUBLIC — STOREFRONT READS (no auth needed)
    // ════════════════════════════════════════════════════

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /featureFlags/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /referralConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /subscriptionConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /loadingFacts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /siteStats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /feedback/{docId} {
      allow read: if true;
      allow create: if isValidFeedbackCreate();
      allow update: if true;
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create: if isValidCustomerCreate();
      allow update: if true;
      allow delete: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrderCreate();
      allow update: if true;
      allow delete: if true;
    }

    match /subscriptions/{subId} {
      allow read: if true;
      allow create: if isValidSubscriptionCreate();
      allow update: if true;
      allow delete: if true;
    }

    match /stock/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /expenses/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /batches/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /productRecipes/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /rawMaterialCosts/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /rawMaterialPurchases/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /rawMaterials/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Contains admin PINs — closed to every client.
    // Login, PIN changes and the login screen's user list all go through the
    // adminAuth Cloud Function, which uses the Admin SDK and bypasses these
    // rules. A PIN never reaches a browser.
    match /adminUsers/{docId} {
      allow read, write: if false;
    }

    // Failed-login counters written by adminAuth. Client access would let an
    // attacker clear their own lockout.
    match /authThrottle/{docId} {
      allow read, write: if false;
    }

    // Contains agent PINs + commission data
    match /agents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // settings — mixed contents, so this is per-document.
    //   settings/admin holds the legacy admin PIN: closed to clients.
    //   the rest (referral_config, subscription_config, feature_flags,
    //   raw_material_costs, handlers) is read by the storefront and admin UI.
    match /settings/{docId} {
      allow read, write: if docId != 'admin';
    }

    // Internal audit trail
    match /activityLog/{docId} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════
    // CATCH-ALL — deny anything not listed above
    // ════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════
    // VALIDATION HELPERS
    // ════════════════════════════════════════════════════

    function isValidOrderCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['orderNumber', 'customerName', 'customerWhatsapp',
                              'items', 'total', 'status', 'createdAt'])
        && d.customerName is string
        && d.customerName.size() > 0
        && d.customerName.size() < 100
        && d.customerWhatsapp is string
        && d.customerWhatsapp.matches('[0-9]{10}')
        && d.total is number
        && d.total >= 0
        && d.total < 100000
        && d.items is list
        && d.items.size() > 0
        && d.items.size() <= 30
        && d.status in ['pending', 'confirmed']
        && d.createdAt is string;
    }

    function isValidCustomerCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'whatsapp', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() < 100
        && d.whatsapp is string
        && d.whatsapp.matches('[0-9]{10}')
        && d.createdAt is string;
    }

    function isValidSubscriptionCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['customerName', 'customerWhatsapp', 'items',
                              'duration', 'createdAt'])
        && d.customerName is string
        && d.customerName.size() > 0
        && d.customerName.size() < 100
        && d.customerWhatsapp is string
        && d.customerWhatsapp.matches('[0-9]{10}')
        && d.items is list
        && d.items.size() > 0
        && d.createdAt is string;
    }

    function isValidFeedbackCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['rating', 'whatYouLiked', 'createdAt'])
        && d.rating is int
        && d.rating >= 1
        && d.rating <= 5
        && d.whatYouLiked is string
        && d.whatYouLiked.size() > 0
        && d.whatYouLiked.size() < 500
        && d.createdAt is string;
    }
  }
}
