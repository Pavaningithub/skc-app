rules_version = '2';

// Sri Krishna Condiments — Firestore Security Rules
//
// ⚠️  ARCHITECTURE NOTE: PINs are the interface; Firebase Auth is the mechanism.
// The Firebase API key IS intentionally public — it only identifies the project,
// it does not grant access by itself. Security comes from these rules.
//
// Identity comes from a Firebase custom token minted by the adminAuth function
// after a PIN is verified server-side. Rules check request.auth.token.admin and
// .agent — a PIN alone proves nothing to Firestore.
//
// What these rules protect:
//   ✅ adminUsers, settings/admin, authThrottle — closed to all clients
//   ✅ agents (PINs, commissions) — admin only; an agent sees only its own record
//   ✅ expenses, batches, productRecipes, rawMaterials, rawMaterialPurchases,
//      rawMaterialCosts — admin only
//   ✅ products, settings — world readable (the storefront needs them),
//      admin only to write, so nobody else can change a price
//
// ⚠️  WHAT IS STILL OPEN, and why rules cannot close it:
//   ⚠️  customers and orders are world readable and writable, including delete.
//   ⚠️  stock is world writable.
//   ⚠️  subscriptions are world readable and writable.
//
//   These are not an oversight in the rules. The storefront performs them from
//   an anonymous browser while a customer checks out: it upserts the customer,
//   creates the order, deducts stock and adjusts referral credit. A customer
//   has no login, so no rule can distinguish them from anyone else.
//
//   Closing these requires moving checkout server-side — one placeOrder function
//   doing the customer upsert, order creation, stock deduction and referral
//   credit together — after which the storefront needs no write access at all.
//   Until then, treat customer names, phone numbers, order history, stock levels
//   and referral credit as publicly readable and modifiable.

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════
    // IDENTITY — set by the custom token adminAuth mints
    // ════════════════════════════════════════════════════

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAgent() {
      return request.auth != null && request.auth.token.agent == true;
    }

    // ════════════════════════════════════════════════════
    // PUBLIC — STOREFRONT READS (no auth needed)
    // ════════════════════════════════════════════════════

    match /products/{productId} {
      allow read: if true;                       // storefront needs the catalogue
      allow create, update, delete: if isAdmin(); // only admins change prices
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /featureFlags/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /referralConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /subscriptionConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /loadingFacts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /siteStats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /feedback/{docId} {
      allow read: if true;
      allow create: if isValidFeedbackCreate();
      allow update: if true;
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create: if isValidCustomerCreate();
      allow update: if true;
      allow delete: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrderCreate();
      allow update: if true;
      allow delete: if true;
    }

    match /subscriptions/{subId} {
      allow read: if true;
      allow create: if isValidSubscriptionCreate();
      allow update: if true;
      allow delete: if true;
    }

    match /stock/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /expenses/{docId} {
      allow read, write: if isAdmin();
    }

    match /batches/{docId} {
      allow read, write: if isAdmin();
    }

    match /productRecipes/{docId} {
      allow read, write: if isAdmin();
    }

    match /rawMaterialCosts/{docId} {
      allow read, write: if isAdmin();
    }

    match /rawMaterialPurchases/{docId} {
      allow read, write: if isAdmin();
    }

    match /rawMaterials/{docId} {
      allow read, write: if isAdmin();
    }

    // Contains admin PINs — closed to every client.
    // Login, PIN changes and the login screen's user list all go through the
    // adminAuth Cloud Function, which uses the Admin SDK and bypasses these
    // rules. A PIN never reaches a browser.
    match /adminUsers/{docId} {
      allow read, write: if false;
    }

    // Failed-login counters written by adminAuth. Client access would let an
    // attacker clear their own lockout.
    match /authThrottle/{docId} {
      allow read, write: if false;
    }

    // Contains agent PINs and commission data. Login and PIN changes go through
    // the adminAuth function; an agent may read and update only its own record.
    match /agents/{docId} {
      allow read: if isAdmin() || (isAgent() && request.auth.token.agentId == docId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAgent() && request.auth.token.agentId == docId);
    }

    // settings — mixed contents, so this is per-document.
    //   settings/admin holds the legacy admin PIN: closed to clients.
    //   the rest (referral_config, subscription_config, feature_flags,
    //   raw_material_costs, handlers) is read by the storefront and admin UI.
    match /settings/{docId} {
      allow read: if docId != 'admin';   // referral/subscription/feature config
      allow write: if isAdmin();
    }

    // Internal audit trail
    match /activityLog/{docId} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════
    // CATCH-ALL — deny anything not listed above
    // ════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════
    // VALIDATION HELPERS
    // ════════════════════════════════════════════════════

    function isValidOrderCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['orderNumber', 'customerName', 'customerWhatsapp',
                              'items', 'total', 'status', 'createdAt'])
        && d.customerName is string
        && d.customerName.size() > 0
        && d.customerName.size() < 100
        && d.customerWhatsapp is string
        && d.customerWhatsapp.matches('[0-9]{10}')
        && d.total is number
        && d.total >= 0
        && d.total < 100000
        && d.items is list
        && d.items.size() > 0
        && d.items.size() <= 30
        && d.status in ['pending', 'confirmed']
        && d.createdAt is string;
    }

    function isValidCustomerCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'whatsapp', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() < 100
        && d.whatsapp is string
        && d.whatsapp.matches('[0-9]{10}')
        && d.createdAt is string;
    }

    function isValidSubscriptionCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['customerName', 'customerWhatsapp', 'items',
                              'duration', 'createdAt'])
        && d.customerName is string
        && d.customerName.size() > 0
        && d.customerName.size() < 100
        && d.customerWhatsapp is string
        && d.customerWhatsapp.matches('[0-9]{10}')
        && d.items is list
        && d.items.size() > 0
        && d.createdAt is string;
    }

    function isValidFeedbackCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['rating', 'whatYouLiked', 'createdAt'])
        && d.rating is int
        && d.rating >= 1
        && d.rating <= 5
        && d.whatYouLiked is string
        && d.whatYouLiked.size() > 0
        && d.whatYouLiked.size() < 500
        && d.createdAt is string;
    }
  }
}
